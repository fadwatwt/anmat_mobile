{
  "name": "anmat_mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.16.2",
    "@react-navigation/material-top-tabs": "^7.5.1",
    "@react-navigation/native": "^7.2.5",
    "@react-navigation/native-stack": "^7.16.0",
    "axios": "^1.17.0",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.26",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.24",
    "i18next": "^26.3.1",
    "i18next-resources-to-backend": "^1.2.1",
    "lucide-react-native": "^1.17.0",
    "metro-file-map": "^0.84.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.8",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-tab-view": "^4.3.1",
    "react-native-web": "^0.21.2",
    "react-native-webrtc": "^124.0.8",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "detox": "^20.51.4",
    "jest": "~29.7.0",
    "serve": "^14.2.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "e2e:build:debug": "eas build --platform android --profile detox-debug",
    "e2e:build:release": "eas build --platform android --profile detox-release",
    "e2e:test": "detox test --configuration android.emu.debug",
    "e2e:test:release": "detox test --configuration android.emu.release",
    "e2e:test:overflow": "detox test e2e/tests/layout-overflow.e2e.js --configuration android.emu.debug",
    "e2e:test:safe-area": "detox test e2e/tests/safe-area.e2e.js --configuration android.emu.debug",
    "e2e:test:spacing": "detox test e2e/tests/spacing-consistency.e2e.js --configuration android.emu.debug",
    "e2e:test:header": "detox test e2e/tests/header-layout.e2e.js --configuration android.emu.debug",
    "e2e:test:sidebar": "detox test e2e/tests/sidebar-layout.e2e.js --configuration android.emu.debug",
    "e2e:test:modal": "detox test e2e/tests/modal-layout.e2e.js --configuration android.emu.debug",
    "e2e:test:rtl": "detox test e2e/tests/rtl-layout.e2e.js --configuration android.emu.debug",
    "e2e:test:sizes": "detox test e2e/tests/screen-sizes.e2e.js --configuration android.emu.debug",
    "e2e:update-baselines": "detox test --configuration android.emu.debug --update-snapshots",
    "check": "node scripts/check.mjs",
    "check:fast": "node scripts/check.mjs --fast",
    "test:layout": "jest __tests__/layout-static-analysis.test.js",
    "test:layout:watch": "jest __tests__/layout-static-analysis.test.js --watch",
    "web:build": "expo export --platform web --output-dir dist-web",
    "web:serve": "serve dist-web -l 19006 --single --no-clipboard",
    "test:subscriber": "node scripts/subscriber-e2e.mjs"
  },
  "private": true
}
