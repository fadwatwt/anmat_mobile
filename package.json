  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "e2e:build:debug": "eas build --platform android --profile detox-debug",
    "e2e:build:release": "eas build --platform android --profile detox-release",
    "e2e:test": "detox test --configuration android.emu.debug",
    "e2e:test:release": "detox test --configuration android.emu.release",
    "e2e:test:overflow": "detox test e2e/tests/layout-overflow.e2e.js --configuration android.emu.debug",
    "e2e:test:safe-area": "detox test e2e/tests/safe-area.e2e.js --configuration android.emu.debug",
    "e2e:test:spacing": "detox test e2e/tests/spacing-consistency.e2e.js --configuration android.emu.debug",
    "e2e:test:header": "detox test e2e/tests/header-layout.e2e.js --configuration android.emu.debug",
    "e2e:test:sidebar": "detox test e2e/tests/sidebar-layout.e2e.js --configuration android.emu.debug",
    "e2e:test:modal": "detox test e2e/tests/modal-layout.e2e.js --configuration android.emu.debug",
    "e2e:test:rtl": "detox test e2e/tests/rtl-layout.e2e.js --configuration android.emu.debug",
    "e2e:test:sizes": "detox test e2e/tests/screen-sizes.e2e.js --configuration android.emu.debug",
    "e2e:update-baselines": "detox test --configuration android.emu.debug --update-snapshots",
    "test:layout": "jest __tests__/layout-static-analysis.test.js",
    "test:layout:watch": "jest __tests__/layout-static-analysis.test.js --watch"
